# AI Island API keys. Copy this file to .env (same folder) and paste each key after the =.
# Never commit .env, and never paste a key into a chat or a doc.
# Only paid commands (calibrate, judge-check, AI runs) use these; the fake AI and the tests need none.

# Anthropic key, for player 1 (Claude main model and its helper)
ANTHROPIC_API_KEY=your-anthropic-key-here
# OpenAI key, for player 2 (GPT main model and its helper)
OPENAI_API_KEY=your-openai-key-here
# Google AI Studio key, for player 3 (Gemini main model and its helper)
GEMINI_API_KEY=your-gemini-key-here
# xAI key, for player 4 (Grok main model and its helper)
XAI_API_KEY=your-xai-key-here
# Mistral key, for the neutral judge
MISTRAL_API_KEY=your-mistral-key-here
